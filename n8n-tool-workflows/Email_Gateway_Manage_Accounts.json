        "query": "UPDATE email_accounts\nSET \n  name = COALESCE('{{ $('Webhook').item.json.body.name }}', name),\n  imap_host = COALESCE('{{ $('Webhook').item.json.body.imap_host }}', imap_host),\n  imap_port = COALESCE({{ $('Webhook').item.json.body.imap_port }}, imap_port),\n  smtp_host = COALESCE('{{ $('Webhook').item.json.body.smtp_host }}', smtp_host),\n  smtp_port = COALESCE({{ $('Webhook').item.json.body.smtp_port }}, smtp_port),\n  credentials = COALESCE('{{ JSON.stringify($('Webhook').item.json.body.credentials) }}'::jsonb, credentials),\n  active = COALESCE({{ $('Webhook').item.json.body.active }}, active)\nWHERE id = '{{ $('Webhook').item.json.body.id }}'\nRETURNING *;",
