{
  "name": "Email Gateway - Send Email",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "send-email",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-trigger",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        240,
        300
      ],
      "webhookId": "send-email-webhook"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, smtp_host, smtp_port, credentials\nFROM email_accounts\nWHERE id = '{{ $json.body.account_id }}'\n  AND active = true",
        "options": {}
      },
      "id": "get-email-account",
      "name": "Get Email Account",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "fromEmail": "={{ $json.email }}",
        "toEmail": "={{ $('Webhook').item.json.body.to }}",
        "subject": "={{ $('Webhook').item.json.body.subject }}",
        "emailType": "text",
        "message": "={{ $('Webhook').item.json.body.message }}",
        "options": {}
      },
      "id": "send-email-smtp",
      "name": "Send Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        680,
        300
      ],
      "credentials": {
        "smtp": {
          "id": "PLACEHOLDER",
          "name": "SMTP account"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "email_logs",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "account_id": "={{ $('Get Email Account').item.json.id }}",
            "direction": "out",
            "subject": "={{ $('Webhook').item.json.body.subject }}",
            "body": "={{ $('Webhook').item.json.body.message }}",
            "metadata": "={{ JSON.stringify({ to: $('Webhook').item.json.body.to, sent_at: new Date().toISOString() }) }}"
          }
        },
        "options": {}
      },
      "id": "log-outgoing-email",
      "name": "Log Outgoing Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": true, \"message\": \"Email sent successfully\", \"email_id\": $json.id } }}",
        "options": {}
      },
      "id": "respond-to-webhook",
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ]
    }
  ],
  "pinData": {},
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Get Email Account",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Email Account": {
      "main": [
        [
          {
            "node": "Send Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send Email": {
      "main": [
        [
          {
            "node": "Log Outgoing Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Log Outgoing Email": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "local-n8n-instance"
  },
  "id": "email-gateway-send",
  "tags": []
}
