{
  "name": "Email Gateway - Read Emails",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "email-schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, email, imap_host, imap_port, credentials\nFROM email_accounts\nWHERE active = true",
        "options": {}
      },
      "id": "get-active-accounts",
      "name": "Get Active Email Accounts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        460,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    },
    {
      "parameters": {
        "mailbox": "INBOX",
        "format": "simple",
        "options": {
          "allowUnauthorizedCerts": true
        }
      },
      "id": "imap-email-read",
      "name": "IMAP Email",
      "type": "n8n-nodes-base.emailReadImap",
      "typeVersion": 2.1,
      "position": [
        680,
        300
      ],
      "credentials": {
        "imap": {
          "id": "PLACEHOLDER",
          "name": "IMAP account"
        }
      }
    },
    {
      "parameters": {
        "operation": "insert",
        "schema": {
          "__rl": true,
          "value": "public",
          "mode": "list"
        },
        "table": {
          "__rl": true,
          "value": "email_logs",
          "mode": "list"
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "account_id": "={{ $json.account_id }}",
            "direction": "in",
            "subject": "={{ $json.subject }}",
            "body": "={{ $json.text }}",
            "metadata": "={{ JSON.stringify({ from: $json.from, to: $json.to, date: $json.date }) }}"
          }
        },
        "options": {}
      },
      "id": "log-incoming-email",
      "name": "Log Incoming Email",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        900,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "PLACEHOLDER",
          "name": "Postgres account"
        }
      }
    }
  ],
  "pinData": {},
  "connections": {
    "Schedule Trigger": {
      "main": [
        [
          {
            "node": "Get Active Email Accounts",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Active Email Accounts": {
      "main": [
        [
          {
            "node": "IMAP Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "IMAP Email": {
      "main": [
        [
          {
            "node": "Log Incoming Email",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1"
  },
  "versionId": "1",
  "meta": {
    "templateCredsSetupCompleted": true,
    "instanceId": "local-n8n-instance"
  },
  "id": "email-gateway-read",
  "tags": []
}
